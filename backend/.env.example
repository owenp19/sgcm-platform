APP_NAME=SGCM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tudominio.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL (hosting compartido / XAMPP)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sgcm_db
DB_USERNAME=usuario_db
DB_PASSWORD=contrasena_db

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

# ============================================================
# ESCALABILIDAD / ALTA CONCURRENCIA (10k-100k usuarios)
# -------------------------------------------
# Para producción con mucha carga se recomienda Redis en vez de
# file/database. El código ya está preparado (caché de tarifa,
# comunicados, etc.); solo hay que:
#   1) composer require predis/predis
#   2) levantar un servidor Redis (o usar Redis Cloud / Upstash)
#   3) apuntar los drivers a redis con las variables de abajo
#
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_QUEUE=queues
#
# Para tráfico muy alto agregar Laravel Horizon (cola Redis) y un
# balanceador + múltiples workers.
# ============================================================

# SMTP (el mismo del backend Node)
MAIL_MAILER=smtp
MAIL_HOST=mail.tudominio.com
MAIL_PORT=587
MAIL_USERNAME=occre@tudominio.com
MAIL_PASSWORD=contrasena_smtp
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="occre@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT — generar con: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=10080

# Frontend Ionic (origen CORS, links QR, pagos sandbox, reset password)
# '*' solo para pruebas; en producción lista separada por comas
FRONTEND_URL=https://tu-app-ionic.com

# Asistente virtual Miss Lorna (Gemini)
# Nota: las cuentas nuevas NO pueden usar gemini-2.5-flash; usa gemini-3.6-flash.
# Obtén la API key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Pasarela de pagos (tarjeta de turismo)
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_PROVIDER=sandbox
PAYMENT_GATEWAY_URL=
PAYMENT_WEBHOOK_SECRET=cambia-este-secreto-hmac
PAYMENT_WEBHOOK_VERIFY=true

# Firebase Cloud Messaging (push) — ruta absoluta al JSON de cuenta de servicio
FIREBASE_CREDENTIALS=

# Seeders (usuarios iniciales)
SEED_EMAIL=owen@sgcm.app
SEED_PASSWORD=1234567
SEED_FIRST_NAME=Owen
SEED_LAST_NAME=SGCM
SEED_FUNCIONARIO_EMAIL=owen@sgcm.com
SEED_FUNCIONARIO_PASSWORD=1234567
